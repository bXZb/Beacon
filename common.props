<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- beacon 四变体（beacon/dnsb/extc2/pivot）共有的构建属性。
       各 .vcxproj 在 <Import Microsoft.Cpp.props> 之后导入本表。

       版本约束（来源：编译与瘦身指南 §1，均为实机踩坑结论）：
       - 工具集 v142 (14.29)：v143 在部分源码上触发 winnt.h C1017 / winreg.h C1001 ICE，
         v141(14.16) 有 CL.exe 0xC0000409 崩溃。可用 /p:BeaconToolset=v143 在新环境试验。
       - SDK 10.0.19041.0：26100 有回归。可用 /p:BeaconSDK= 覆盖。
       - 64 位 cl（PreferredToolArchitecture=x64）：默认 32 位 HostX86\x64 编 tomcrypt
         大模板会 C1060（4GB 地址空间限制，与物理内存无关）。 -->
  <PropertyGroup>
    <BeaconToolset Condition="'$(BeaconToolset)' == ''">v142</BeaconToolset>
    <BeaconSDK Condition="'$(BeaconSDK)' == ''">10.0.19041.0</BeaconSDK>
    <!-- 预编译依赖库：lib\tomcrypt.x64.lib / lib\tommath.x64.lib（版本记录见 lib\VERSIONS.md） -->
    <LibraryPath>$(ProjectDir)lib;$(LibraryPath)</LibraryPath>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>

  <!-- Release 共通链接/编译策略：产物按体积优化、生成 MAP 供 .obj 级归因分析。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GenerateManifest>false</GenerateManifest>
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <!-- 告警基线 Level3：修复告警而不压制它；禁止在本仓库内改回 TurnOffAllWarnings -->
      <WarningLevel>Level3</WarningLevel>
      <AdditionalIncludeDirectories>$(ProjectDir)tomcrypt-headers;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <MapExports>true</MapExports>
    </Link>
  </ItemDefinitionGroup>

</Project>
